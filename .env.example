# Environment variables of the Vercel project (Settings → Environment Variables). None is needed to build or test
# locally: without them the site is not indexed, sells nothing and the contact form opens the reader's mail program.
# See docs/DEPLOY.md for what each one does and when to set it.

# The canonical address (default https://www.nederlands.app). Set only to move the site.
SITE_URL=
# "on" lets search engines index the site (Production only; previews are never indexed).
INDEXING=
# "off" turns the cookieless Vercel Web Analytics off (on by default in Production).
ANALYTICS=

# Mail through Resend: the contact form, and the access link after a purchase.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
MAIL_FROM=

# Selling access through Mollie. PAYMENTS=on only once the rest is set and config/company.js is complete.
PAYMENTS=
MOLLIE_API_KEY=
# A long random string that signs the access codes. Never change it once codes have been sold.
ACCESS_SECRET=
