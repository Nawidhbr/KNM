---
import { needsAccess, priceText, selling } from "../../../lib/offer";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { fmt, localePaths, t } from "../../../i18n";
import { getThemeIndex, tx } from "@knm/content";
import { themePath, themes } from "../../../lib/course";
import { breadcrumbs, course } from "../../../lib/structured-data";

/** The study portal: the eight themes of the exam as cards; those with a course link to it, the others are in preparation. */
export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const S = ui.study;
const courses = new Map(themes().map((x) => [x.id, x]));
---

<BaseLayout
  title={S.title}
  description={S.description}
  path="/study/"
  locale={locale}
  wide
  jsonLd={[
    breadcrumbs([{ name: ui.nav.home, path: `/${locale}/` }, { name: S.title, path: `/${locale}/study/` }]),
    ...themes().map((x) => course({ name: tx(x.title, locale), description: tx(x.lead, locale), path: themePath(locale, x.id), locale })),
  ]}
>
  <p class="crumbs"><a href={`/${locale}/`}>{ui.nav.home}</a> / {S.title}</p>
  <header class="study-head">
    <h1>{S.title}</h1>
    <p class="lead">{S.lead}</p>
  </header>

  {selling() && (
    <section class="card buy-banner" data-buy>
      <div>
        <h2>{fmt(ui.buy.bannerTitle, { price: priceText(locale) })}</h2>
        <p class="u-m0">{fmt(ui.buy.bannerBody, { price: priceText(locale) })}</p>
      </div>
      <a class="btn btn-red" href={`/${locale}/unlock/`}>{fmt(ui.buy.cta, { price: priceText(locale) })}</a>
    </section>
  )}
  <ul class="theme-grid">
    {getThemeIndex().map((x) => {
      const c = courses.get(x.id);
      return (
        <li>
          {c ? (
            <a class="card theme-card" href={themePath(locale, x.id)} data-theme-progress={x.id}>
              <span class="tile-wrap" aria-hidden="true"><span class="tile tile-filled"><span>{x.n}</span></span></span>
              <span class="theme-body">
                <span class="eyebrow">{fmt(S.themeLabel, { n: x.n })}</span>
                <strong>{tx(x.title, locale)}</strong>
                <span class="theme-lead">{tx(x.lead, locale)}</span>
                <span class="theme-meta">{fmt(S.lessons, { n: c.lessons.length })}{needsAccess(x.n) && <span class="theme-tag" data-buy>{ui.buy.tag}</span>}</span>
                <span class="theme-count" data-count data-text={S.progress} hidden></span>
              </span>
            </a>
          ) : (
            <div class="card theme-card" data-soon>
              <span class="tile-wrap" aria-hidden="true"><span class="tile"><span>{x.n}</span></span></span>
              <span class="theme-body">
                <span class="eyebrow">{fmt(S.themeLabel, { n: x.n })}</span>
                <strong>{tx(x.title, locale)}</strong>
                <span class="theme-lead">{tx(x.lead, locale)}</span>
                <span class="theme-meta">{S.soonLong}</span>
              </span>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  <section class="card practice-exam">
    <h2>{ui.exam.title}</h2>
    <p>{ui.practice.examLead}</p>
    <p class="practice-more">
      <a class="btn btn-red" href={`/${locale}/exam/`}>{ui.practice.examCta}</a>
      <a class="btn btn-outline" href={`/${locale}/practice/`}>{ui.nav.practice}</a>
    </p>
  </section>
</BaseLayout>
