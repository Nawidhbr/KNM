---
import { selling } from "../../lib/offer";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";
import { fmt, localePaths, t } from "../../i18n";

export const getStaticPaths = localePaths;
const { locale } = Astro.params as { locale: string };
const ui = t(locale);
const P = ui.privacy;
---

<BaseLayout title={P.title} description={fmt(P.description, { site: SITE.name })} path="/privacy/" locale={locale}>
  <p class="crumbs"><a href={`/${locale}/`}>{ui.nav.home}</a> / {P.title}</p>
  <h1>{P.title}</h1>
  {(P.body as string[]).map((p) => <p>{p}</p>)}
  {selling() && (P.payments as string[]).map((p) => <p>{p}</p>)}
</BaseLayout>
